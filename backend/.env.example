# Copy this file to .env and fill in real values. Never commit .env.

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:4200

# ── Database & cache ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospynai
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate strong random secrets, e.g.: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Email (SendGrid) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=
FROM_EMAIL=noreply@hospynai.com

# ── SMS & voice (Twilio) ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Only required for the AI calling agent's emergency/human handoff transfers
HUMAN_AGENT_NUMBER=
EMERGENCY_NUMBER=911
API_URL=http://localhost:5000

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ── AI — Groq (primary LLM + speech-to-text) ────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional — used for RAG embeddings (Groq does not provide an embeddings API)
# and as an LLM fallback provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── AI memory (Qdrant vector search) ────────────────────────────────────────
QDRANT_URL=
QDRANT_API_KEY=

# ── File storage (Cloudinary) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hospyn_ai

# ── Blockchain (Polygon) — safe to leave disabled locally ──────────────────
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK_ID=80002
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_RPC_URL=
POLYGON_MAINNET_RPC=https://polygon-rpc.com
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
BLOCKCHAIN_DEPLOYMENTS_FILE=
BLOCKCHAIN_DEFAULT_PROVIDER_ADDRESS=
# Printed by `blockchain/scripts/deploy.ts` after a deploy
MEDICAL_RECORD_ANCHOR_ADDRESS=
PATIENT_CONSENT_ADDRESS=
PRESCRIPTION_VERIFIER_ADDRESS=
MEDICAL_DATA_REGISTRY_ADDRESS=
