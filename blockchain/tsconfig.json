{
  "compilerOptions": {
    "lib": ["es2022"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "outDir": "dist",
    "types": ["node", "mocha", "hardhat", "@nomicfoundation/hardhat-ethers"],
    "verbatimModuleSyntax": true
  }
}
