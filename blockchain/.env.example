# Network RPC URLs
POLYGON_MAINNET_RPC=https://polygon-mainnet.g.alchemy.com/v2/your-alchemy-api-key
POLYGON_AMOY_RPC=https://polygon-amoy.g.alchemy.com/v2/your-alchemy-api-key

# Private key for deployment (without 0x prefix). NEVER commit a real key.
# Generate a dedicated deployer key for this project — do not reuse a personal wallet.
BLOCKCHAIN_PRIVATE_KEY=

# Platform wallet address (public, safe to share)
PLATFORM_WALLET=

# Polygonscan API key for contract verification
POLYGONSCAN_API_KEY=

# Optional
REPORT_GAS=true
COINMARKETCAP_API_KEY=
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK_ID=31337
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_DEPLOYMENTS_FILE=./deployments/localhost.json
